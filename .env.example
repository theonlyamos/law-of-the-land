# RAG document search (GroundX) and answer generation (Gemini). Local Next.js
# routes and Convex actions both use these server-only values. In hosted
# environments, set them in both Vercel and Convex; never commit real values.
GROUNDX_API_KEY=
GOOGLE_AI_API_KEY=

# Convex (run `bunx convex dev` to create a project and fill these in)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only shared secret for the protected Convex jurisdiction endpoint.
# Set the same value in the Next.js host and Convex deployment; never prefix it
# with NEXT_PUBLIC_.
SEARCH_JURISDICTION_SECRET=

# Maximum size, in bytes, for governed legal originals uploaded to Convex.
# Required for the administrative upload control to be enabled.
ADMIN_MAX_DOCUMENT_BYTES=52428800

# Set in Convex dashboard: npx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Used by Better Auth for OAuth redirects (also set SITE_URL in Convex dashboard)
SITE_URL=http://localhost:3000

# Comma-separated Better Auth user IDs eligible for the one-time, 2FA-gated
# super-admin bootstrap. Keep empty outside controlled bootstrap operations.
INITIAL_SUPER_ADMIN_IDS=

# Optional OAuth providers (set in Convex dashboard for server-side auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email verification (set in Convex dashboard). Without RESEND_API_KEY,
# verification links are logged to the Convex console instead of emailed —
# fine for dev, required for production sign-ups to work.
RESEND_API_KEY=
EMAIL_FROM=

# Admin control plane. The panel is off unless this deployment gate is exactly
# "true" and the matching featureFlags admin_panel row is enabled for
# ADMIN_ENVIRONMENT. Keep false through bootstrap and release verification.
ADMIN_PANEL_ENABLED=false
ADMIN_ENVIRONMENT=

# Billing via Polar (all set in Convex dashboard).
# Limits are enforced only when BILLING_ENABLED=true; usage is counted either way.
# Webhook endpoint: the configured Convex Site URL plus /polar/events
# (events: product.created, product.updated, subscription.created, subscription.updated)
BILLING_ENABLED=false
POLAR_ORGANIZATION_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRO_MONTHLY_PRODUCT_ID=
